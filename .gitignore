# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart

# Platform folders generated by `flutter create .`
# android/ is intentionally tracked (see below) since it now carries a
# real, verified fix (core library desugaring for flutter_local_notifications)
# that shouldn't need re-applying on every fresh clone.
/ios/
/web/
/macos/
/linux/
/windows/

# Gradle build output inside android/ (keep the config, not the build cache)
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/**/gradle-wrapper.jar
/android/key.properties

# IDE
.idea/
.vscode/
*.iml

# Misc
.DS_Store
